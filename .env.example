# Copy to .env and fill in. NEVER commit .env.
# azure = Azure OpenAI; anything else = the OpenAI API, or an OpenAI-compatible service at LLM_ENDPOINT
LLM_PROVIDER=azure
LLM_API_KEY=paste-your-key-here
LLM_ENDPOINT=https://your-resource.openai.azure.com
LLM_MODEL=your-model-deployment-name
AZURE_API_VERSION=2024-12-01-preview
# The SEC asks automated tools to give a name and contact email with every request
SEC_USER_AGENT=Mandate (your-email@example.com)
